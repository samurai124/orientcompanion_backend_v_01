# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# Database (Local MariaDB / MySQL)
DATABASE_URL="mysql://orient:orient123@127.0.0.1:3306/orientcompanion"

# JWT Secrets
JWT_ACCESS_SECRET="orientcompanion_access_super_secret_jwt_key_2026_at_least_32_chars"
JWT_REFRESH_SECRET="orientcompanion_refresh_super_secret_jwt_key_2026_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# LLM & Embedding Settings
EMBEDDING_PROVIDER="fake"
GEMINI_API_KEY=""

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Email Settings (SMTP - uses console/stream in dev if empty)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@orientcompanion.ma"
